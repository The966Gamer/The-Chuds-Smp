# -------------------------------------------------------------
# TheChudSMP Panel - Environment Variables
# Copy and paste this directly into your .env file or hosting provider
# -------------------------------------------------------------

# FalixNodes API (From Falix Client > Profile > API Credentials)
FALIX_API_BASE=https://client.falixnodes.net/api/v2
FALIX_API_KEY=
FALIX_SERVER_ID=

# Minecraft Server Connection
MINECRAFT_SERVER_HOST=
MINECRAFT_SERVER_PORT=25565

# Minecraft RCON (From server.properties)
RCON_PORT=25575
RCON_PASSWORD=

# Minecraft Mod Webhook Key (Used by Fabric Mod / KubeJS)
INTEGRATION_SECRET_KEY=chudsmp-secret

# Discord Integration
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=

# Database / Supabase (Optional persistent storage)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Panel Authentication & Admin
ADMIN_USERNAME=SuperDuck220
ADMIN_PASSWORD=chudsmp2026
SESSION_SECRET=thechudsmp-super-secret-session-key
