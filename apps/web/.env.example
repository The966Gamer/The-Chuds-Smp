# TheChudSmp Web Control Panel (Netlify / Node.js)
# Server-side environment variables (never exposed to browser JavaScript)

# FalixNodes API credentials (from client.falixnodes.net/api-docs)
FALIX_API_BASE="https://client.falixnodes.net/api/v2"
FALIX_API_KEY="falix_..."
FALIX_SERVER_ID="12345"

# Minecraft Server Host & Port
MINECRAFT_SERVER_HOST="node.falixnodes.net"
MINECRAFT_SERVER_PORT="25565"

# Source RCON (optional console fallback)
RCON_PORT="25575"
RCON_PASSWORD="your-secure-rcon-password"

# PostgreSQL / Supabase Database
# Preferred: Direct connection string or pooler
DATABASE_URL="postgres://postgres:password@db.xxxx.supabase.co:5432/postgres"

# Alternative Supabase credentials
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="eyJhb..."
SUPABASE_SERVICE_ROLE_KEY="eyJhb..."
SUPABASE_DB_PASSWORD="your-supabase-db-password"

# Shared secret key for in-game Minecraft mod/plugin HTTP events
INTEGRATION_SECRET_KEY="replace-with-a-random-32-byte-hex-string"

# Discord Webhook for notifications
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Discord Bot Token (used to dispatch slash commands and notify worker)
DISCORD_BOT_TOKEN="MTA..."

# Session encryption secret
SESSION_SECRET="replace-with-a-secure-random-session-secret"

# Initial administrator username (password chosen on first run)
ADMIN_USERNAME="SuperDuck220"
