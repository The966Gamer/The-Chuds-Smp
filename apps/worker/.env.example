# TheChudSmp Discord Worker Environment Configuration
# Run on any persistent Node.js host (VPS, Railway, Fly.io, Render, Docker)

# Discord Bot Token (from Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN="MTA..."

# Discord Application / Client ID
DISCORD_CLIENT_ID="123456789012345678"

# Control Panel API Base URL
PANEL_API_URL="https://your-panel-url.example.com"
PANEL_INTEGRATION_KEY="your-shared-integration-secret-key"

# Database Connection (Direct PostgreSQL or Supabase Session Pooler)
DATABASE_URL="postgres://postgres:password@db.xxxx.supabase.co:5432/postgres"

# Optional: Direct Minecraft / RCON details
MINECRAFT_SERVER_HOST="127.0.0.1"
MINECRAFT_SERVER_PORT="25565"
RCON_PORT="25575"
RCON_PASSWORD="your-rcon-password"

# Falix API Credentials
FALIX_API_BASE="https://client.falixnodes.net/api/v2"
FALIX_API_KEY="falix_..."
FALIX_SERVER_ID="12345"
